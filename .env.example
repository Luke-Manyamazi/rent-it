# Firebase project config (Project Settings > General > Your apps > SDK setup and configuration)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Web Push certificate key for Firebase Cloud Messaging (Project Settings > Cloud Messaging > Web configuration)
VITE_FIREBASE_VAPID_KEY=

# Supabase project config, used for file storage only (property photos, avatars,
# verification docs) — Auth/Firestore stay on Firebase. See Supabase project
# Settings > API. Also requires enabling Firebase as a Third-Party Auth
# provider in Supabase Dashboard > Authentication > Sign In / Providers, so
# storage RLS policies can trust the Firebase-issued JWT.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL of the deployed app, used for canonical links and share URLs
VITE_APP_URL=http://localhost:5173
