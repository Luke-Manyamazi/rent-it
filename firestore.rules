rules_version = '2';

/**
 * RBAC note: roles are looked up from the user's own Firestore document
 * (`users/{uid}.role`) rather than Firebase Auth custom claims, because
 * setting custom claims requires the Admin SDK (a Cloud Function), and
 * Cloud Functions are deliberately deferred to Phase 11 (see ARCHITECTURE.md).
 * Each `get()` below costs one document read against the security-rules
 * quota. When Cloud Functions are introduced, migrate `userRole()` to
 * `request.auth.token.role` custom claims for lower latency and cost — the
 * rule *shapes* below stay the same either way.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return currentUser().data.role;
    }

    function isAdmin() {
      return isSignedIn() && userRole() == 'admin';
    }

    function isAgencyMember(agencyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/agencies/$(agencyId)/members/$(request.auth.uid));
    }

    function isAgencyOwner(agencyId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/agencies/$(agencyId)).data.ownerId == request.auth.uid;
    }

    /** The invite (if any) addressed to the caller's own verified email —
     *  see the agencyInvites section for why invites are keyed by email
     *  rather than by uid (no backend exists yet to provision an account
     *  on someone else's behalf). */
    function myInvite() {
      return get(/databases/$(database)/documents/agencyInvites/$(request.auth.token.email));
    }

    /** True if the caller owns this landlord/agency-owned resource. */
    function ownsResource(ownerId, ownerType) {
      return isSignedIn() && (
        (ownerType == 'landlord' && request.auth.uid == ownerId) ||
        (ownerType == 'agency' && isAgencyMember(ownerId))
      );
    }

    // ---------------------------------------------------------------------
    // users
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      // role can only be set to a self-serve role on creation; only an
      // admin can promote/demote a user afterwards (including to 'admin').
      allow create: if isSignedIn() && request.auth.uid == userId &&
        request.resource.data.role in ['tenant', 'landlord', 'agency'] &&
        request.resource.data.isSuspended == false;
      allow update: if isSignedIn() && (
        (request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isSuspended == resource.data.isSuspended) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /private/contact {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      match /savedProperties/{propertyId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      match /trustScoreEvents/{eventId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        // Beyond the Admin SDK (which bypasses rules entirely, used by the
        // Phase 11 auto-cancel job), an admin may also append an event
        // client-side for manual trust score overrides. Never the affected
        // user themselves — a trust score can't be self-inflated.
        allow create: if isAdmin() && request.resource.data.type == 'manual_admin_adjustment';
        allow update, delete: if false;
      }

      match /analyticsRollups/{date} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // agencies
    // ---------------------------------------------------------------------
    match /agencies/{agencyId} {
      allow read: if true;
      allow create: if isSignedIn() && userRole() == 'agency' &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.ownerId == request.auth.uid ||
        isAdmin() ||
        // Phase 16: any agency member (not just the owner) can publish/change
        // a listing's status, so any member may adjust activeListingCount —
        // scoped to that field only.
        (isAgencyMember(agencyId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeListingCount', 'updatedAt']))
      );
      allow delete: if isAdmin();

      match /members/{memberId} {
        allow read: if isSignedIn() && (isAgencyMember(agencyId) || isAdmin());
        // A prospective member may create their own membership doc only if
        // a pending invite addressed to their email names this agency —
        // otherwise only the owner (or admin) may add/remove members.
        allow create: if isSignedIn() && (
          isAgencyOwner(agencyId) ||
          isAdmin() ||
          (request.auth.uid == memberId &&
            request.resource.data.role == 'agent' &&
            myInvite().data.agencyId == agencyId &&
            myInvite().data.status == 'pending')
        );
        allow update, delete: if isSignedIn() && (isAgencyOwner(agencyId) || isAdmin());
      }

      match /trustScoreEvents/{eventId} {
        allow read: if isSignedIn() && (isAgencyMember(agencyId) || isAdmin());
        allow create: if isAdmin() && request.resource.data.type == 'manual_admin_adjustment';
        allow update, delete: if false;
      }

      match /analyticsRollups/{date} {
        allow read: if isSignedIn() && (isAgencyMember(agencyId) || isAdmin());
        allow write: if false;
      }
    }

    // ---------------------------------------------------------------------
    // agencyInvites — keyed by the invited person's email (see myInvite()
    // above). Lets an agency owner add a team member without any backend:
    // the invitee's own signup flow checks for a matching pending invite
    // and joins the existing agency instead of founding a new one.
    // ---------------------------------------------------------------------
    match /agencyInvites/{email} {
      allow read: if isSignedIn() && (
        request.auth.token.email == email ||
        isAgencyMember(resource.data.agencyId) ||
        isAdmin()
      );
      allow create: if isSignedIn() &&
        isAgencyOwner(request.resource.data.agencyId) &&
        request.resource.data.invitedByUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isSignedIn() && (
        (request.auth.token.email == email &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.agencyId == resource.data.agencyId &&
          request.resource.data.invitedByUid == resource.data.invitedByUid &&
          request.resource.data.email == resource.data.email) ||
        isAgencyOwner(resource.data.agencyId) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (isAgencyOwner(resource.data.agencyId) || isAdmin());
    }

    // ---------------------------------------------------------------------
    // properties — public marketplace, but only 'active'/'rented' listings
    // are visible to everyone; draft/pending/suspended are owner+admin only.
    // ---------------------------------------------------------------------
    match /properties/{propertyId} {
      allow read: if resource.data.status in ['active', 'rented'] ||
        ownsResource(resource.data.ownerId, resource.data.ownerType) ||
        isAdmin();
      allow create: if isSignedIn() &&
        userRole() in ['landlord', 'agency'] &&
        ownsResource(request.resource.data.ownerId, request.resource.data.ownerType) &&
        request.resource.data.isVerified == false &&
        request.resource.data.isFlagged == false;
      allow update: if isSignedIn() && (
        (ownsResource(resource.data.ownerId, resource.data.ownerType) &&
          request.resource.data.isVerified == resource.data.isVerified &&
          request.resource.data.ownerId == resource.data.ownerId &&
          request.resource.data.ownerType == resource.data.ownerType) ||
        isAdmin() ||
        // Phase 16: any signed-in non-owner viewing the listing may bump
        // viewCount by exactly 1 — nothing else on the doc.
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount', 'updatedAt']) &&
          request.resource.data.viewCount == resource.data.viewCount + 1)
      );
      allow delete: if isSignedIn() && (ownsResource(resource.data.ownerId, resource.data.ownerType) || isAdmin());
    }

    // ---------------------------------------------------------------------
    // bookings — the Verified Before You Travel state machine.
    // Auto-cancellation (status -> auto_cancelled_no_confirmation) is only
    // ever written by the scheduled Cloud Function via the Admin SDK, so no
    // client rule allows that transition.
    //
    // Phase 17: a booking only exists once its $5 viewing commitment fee is
    // confirmed paid, so creation is exclusively via the scheduled-jobs
    // payments backend's Admin SDK (which bypasses these rules regardless) —
    // `allow create: if false` here just closes the door on a tenant
    // creating an unpaid booking directly. The owner's `rentalOutcome`
    // branch below is the one client-writable field pair this doc gained;
    // see viewingPayments for the linked fee's paid -> forfeited/refunded
    // transition.
    // ---------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.tenantId == request.auth.uid ||
        ownsResource(resource.data.ownerId, resource.data.ownerType) ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isSignedIn() && (
        (resource.data.tenantId == request.auth.uid &&
          request.resource.data.status in ['cancelled_by_tenant']) ||
        (ownsResource(resource.data.ownerId, resource.data.ownerType) &&
          request.resource.data.status in ['confirmed', 'availability_confirmed', 'cancelled_by_owner', 'completed']) ||
        (ownsResource(resource.data.ownerId, resource.data.ownerType) &&
          resource.data.status == 'completed' &&
          resource.data.rentalOutcome == 'pending' &&
          request.resource.data.rentalOutcome in ['rented', 'not_rented']) ||
        isAdmin()
      );
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // viewingPayments — the $5 EcoCash/Paynow viewing commitment fee. Created
    // only by the scheduled-jobs payments backend via the Admin SDK once a
    // tenant starts paying (status 'pending'), then flipped to 'paid'/'failed'
    // by the same backend when Paynow's webhook reports the result.
    //
    // 'paid' -> 'forfeited' (booking marked Rented, or tenant no-show) and
    // 'paid' -> 'refunded' (booking marked Not Rented) are the only client
    // writes allowed, and only by the property's owner — this is what makes
    // the refund instant with no admin approval gate. The fee settles into a
    // single platform Paynow merchant account, not the owner's, so this
    // records that a refund is owed rather than that money has moved; an
    // admin-facing bookkeeping list reads 'refunded' rows to action the
    // actual payout outside this record.
    // ---------------------------------------------------------------------
    match /viewingPayments/{paymentId} {
      allow read: if isSignedIn() && (
        resource.data.tenantId == request.auth.uid ||
        ownsResource(resource.data.ownerId, resource.data.ownerType) ||
        isAdmin()
      );
      allow create: if false;
      allow update: if isSignedIn() &&
        ownsResource(resource.data.ownerId, resource.data.ownerType) &&
        resource.data.status == 'paid' &&
        request.resource.data.status in ['forfeited', 'refunded'];
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // conversations & messages
    // ---------------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      allow create: if isSignedIn() &&
        request.auth.uid in request.resource.data.participantIds &&
        request.resource.data.participantIds.size() == 2;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        allow create: if isSignedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // Only the readBy array may change after creation.
        allow update: if isSignedIn() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']);
        allow delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------------------
    // notifications
    // Known MVP simplification: without Cloud Functions yet, notifications
    // are authored client-side by the acting user (e.g. a tenant creates the
    // "booking_request" notification for the landlord). Phase 13 should move
    // creation into a Firestore-trigger Cloud Function so notification
    // content can't be spoofed by a malicious client.
    // ---------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.recipientId != request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead']);
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // ---------------------------------------------------------------------
    // reviews
    // ---------------------------------------------------------------------
    match /reviews/{reviewId} {
      allow read: if resource.data.moderationStatus == 'visible' ||
        (isSignedIn() && (resource.data.authorId == request.auth.uid || isAdmin()));
      allow create: if isSignedIn() && userRole() == 'tenant' &&
        request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // subscriptions — billing state is server/admin controlled. No real
    // payment gateway integration exists (Phase 14 uses manual proof-of-payment
    // + admin approval, see subscriptionPaymentSubmissions below), so this doc
    // is only ever written by an admin approving a submission.
    // ---------------------------------------------------------------------
    match /subscriptions/{agencyId} {
      allow read: if isSignedIn() && (isAgencyMember(agencyId) || isAdmin());
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // subscriptionPaymentSubmissions — an agency member submits proof of an
    // EcoCash/bank payment (reference number, optional screenshot); only an
    // admin can transition it from 'pending' to 'approved'/'rejected'
    // (approval is what actually writes the subscriptions/{agencyId} doc
    // above, from admin/api/subscriptions.ts).
    // ---------------------------------------------------------------------
    match /subscriptionPaymentSubmissions/{submissionId} {
      allow read: if isSignedIn() &&
        (isAgencyMember(resource.data.agencyId) || isAdmin());
      allow create: if isSignedIn() &&
        isAgencyMember(request.resource.data.agencyId) &&
        request.resource.data.submittedByUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if isAdmin() &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected'];
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // analyticsRollups — platform-wide daily snapshot, written only by
    // scheduled-jobs/api/daily-analytics-rollup.ts via the Admin SDK (which
    // bypasses rules entirely), never by a client.
    // ---------------------------------------------------------------------
    match /analyticsRollups/{date} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------------------------------------------------------------------
    // fraudFlags
    // ---------------------------------------------------------------------
    match /fraudFlags/{flagId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.reportedBy == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.reportedBy == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------------
    // verificationRequests — documents live in Storage, only paths here.
    // ---------------------------------------------------------------------
    match /verificationRequests/{requestId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
